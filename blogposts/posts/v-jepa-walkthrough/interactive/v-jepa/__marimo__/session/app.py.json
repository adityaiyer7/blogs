            "text/html": "\n    <style>\n      #vj-sampled-frames {\n        --vj-muted: #5f6368;\n        --vj-border: #d7d9dc;\n        --vj-frame-fill: #f3f5f7;\n        --vj-frame-ground: #8c9299;\n        --vj-sample: #cf4f24;\n        --vj-progress: #2f6f9f;\n        box-sizing: border-box;\n        margin: 0 auto;\n        max-width: 920px;\n        padding: 0.65rem;\n        width: 100%;\n      }\n\n      #vj-sampled-frames * {\n        box-sizing: border-box;\n      }\n\n      #vj-sampled-frames .vj-sample-heading {\n        align-items: baseline;\n        color: var(--vj-muted);\n        display: flex;\n        flex-wrap: wrap;\n        font-size: 0.84rem;\n        gap: 0.35rem 0.8rem;\n        justify-content: space-between;\n        margin-bottom: 0.65rem;\n      }\n\n      #vj-sampled-frames .vj-sample-heading strong {\n        color: inherit;\n        font-weight: 500;\n      }\n\n      #vj-sampled-frames .vj-sample-grid {\n        display: grid;\n        gap: 0.75rem 0.55rem;\n        grid-template-columns: repeat(8, minmax(0, 1fr));\n      }\n\n      #vj-sampled-frames .vj-sampled-frame {\n        margin: 0;\n        min-width: 0;\n      }\n\n      #vj-sampled-frames .vj-sampled-frame svg {\n        display: block;\n        height: auto;\n        width: 100%;\n      }\n\n      #vj-sampled-frames .vj-frame-background {\n        fill: var(--vj-frame-fill);\n        stroke: var(--vj-border);\n        stroke-width: 1.25;\n        vector-effect: non-scaling-stroke;\n      }\n\n      #vj-sampled-frames .vj-frame-ground {\n        fill: none;\n        stroke: var(--vj-frame-ground);\n        stroke-width: 1;\n        vector-effect: non-scaling-stroke;\n      }\n\n      #vj-sampled-frames .vj-frame-object {\n        fill: var(--vj-sample);\n      }\n\n      #vj-sampled-frames .vj-frame-progress-track {\n        fill: none;\n        stroke: var(--vj-border);\n        stroke-width: 1;\n        vector-effect: non-scaling-stroke;\n      }\n\n      #vj-sampled-frames .vj-frame-progress-dot {\n        fill: var(--vj-progress);\n      }\n\n      #vj-sampled-frames figcaption {\n        color: var(--vj-muted);\n        display: flex;\n        flex-direction: column;\n        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n        font-size: 0.72rem;\n        gap: 0.08rem;\n        margin-top: 0.22rem;\n        text-align: center;\n      }\n\n      #vj-sampled-frames figcaption span:first-child {\n        color: inherit;\n        font-weight: 500;\n      }\n\n      #vj-sampled-frames .vj-sample-summary {\n        color: var(--vj-muted);\n        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n        font-size: 0.82rem;\n        line-height: 1.55;\n        margin-top: 0.75rem;\n        text-align: center;\n      }\n\n      @media (max-width: 760px) {\n        #vj-sampled-frames {\n          padding: 0.35rem;\n        }\n\n        #vj-sampled-frames .vj-sample-grid {\n          grid-template-columns: repeat(4, minmax(0, 1fr));\n        }\n\n        #vj-sampled-frames .vj-sample-heading {\n          align-items: flex-start;\n          flex-direction: column;\n          font-size: 0.76rem;\n        }\n\n        #vj-sampled-frames figcaption {\n          font-size: 0.7rem;\n        }\n\n        #vj-sampled-frames .vj-sample-summary {\n          font-size: 0.74rem;\n        }\n      }\n\n      @media (prefers-color-scheme: dark) {\n        #vj-sampled-frames {\n          --vj-muted: #b8bdc3;\n          --vj-border: #555a60;\n          --vj-frame-fill: #24282d;\n          --vj-frame-ground: #899097;\n          --vj-sample: #ff9a68;\n          --vj-progress: #9bc3ec;\n        }\n      }\n    </style>\n\n    <section\n      id=\"vj-sampled-frames\"\n      aria-label=\"The sixteen frames sampled at four frames per second from the selected temporal window\"\n    >\n      <div class=\"vj-sample-heading\">\n        <span><strong>sampled clip</strong> &middot; 16 schematic frames</span>\n     